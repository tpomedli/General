# Optional. Full web results from https://api-dashboard.search.brave.com/
# Without it, search uses Wikipedia and DuckDuckGo instant answers.
BRAVE_SEARCH_API_KEY=

# Optional. The command-line scraper still uses Firecrawl when you run npm run scrape.
FIRECRAWL_API_KEY=

# Optional. Use a self-hosted or local Firecrawl server instead of the cloud API.
# FIRECRAWL_API_URL=http://localhost:3002
